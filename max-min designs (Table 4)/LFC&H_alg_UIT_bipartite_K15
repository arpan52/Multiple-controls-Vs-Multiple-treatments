# Function for calculating the mean and covariance matrix of Z-ij's and criterion 'Psi'.

psi <- function(design, mu, del, n, sigma, q)
  {
    # ------------------------------------------------------------
    # Comparisons:
    # (1,3), (1,4), ..., (1,15),
    # (2,11), (2,12), ..., (2,15)
    # ------------------------------------------------------------
    comparisons <- rbind(
      cbind(1, 3:15),
      cbind(2, 11:15)
    )
    
    # Number of comparisons
    Ncomp <- nrow(comparisons)  
    
    x[1]<- design[1]
    x[2]<- design[2]
    x[3]<- design[3]
    x[4]<- design[3]
    x[5]<- design[3]
    x[6]<- design[3]
    x[7]<- design[3]
    x[8]<- design[3]
    x[9]<- design[3]
    x[10]<- design[3]
    x[11]<- design[4]
    x[12]<- design[4]
    x[13]<- design[4]
    x[14]<- design[4]
    x[15]<- design[4]
    
    
    # ------------------------------------------------------------
    # Standardised differences and non-centrality parameters
    # ------------------------------------------------------------
    
    delta <- numeric(Ncomp)
    
    for (i in 1:Ncomp)
    {
      a <- comparisons[i, 1]
      b <- comparisons[i, 2]
      
      delta[i] <- ((mu[a] - mu[b]) * n) / sigma
    }
    
    # Non-centrality parameters
    m <- numeric(Ncomp)
    
    for (i in 1:Ncomp)
    {
      a <- comparisons[i, 1]
      b <- comparisons[i, 2]
      
      m[i] <- sqrt((x[a] * x[b]) /
                     (x[a] + x[b])) * delta[i]
    }
    
    # ------------------------------------------------------------
    # Correlation matrix
    # ------------------------------------------------------------
    
    S <- diag(Ncomp)
    
    for (i in 1:(Ncomp - 1))
    {
      for (j in (i + 1):Ncomp)
      {
        a <- comparisons[i, 1]
        b <- comparisons[i, 2]
        
        c <- comparisons[j, 1]
        d <- comparisons[j, 2]
        
        rho <- 0
        
        # Same first treatment/control:
        # (a,b) and (a,d)
        if (a == c)
        {
          rho <- sqrt(
            (x[b] * x[d]) /
              ((x[a] + x[b]) *
                 (x[a] + x[d]))
          )
        }
        
        # Same second treatment:
        # (a,b) and (c,b)
        else if (b == d)
        {
          rho <- sqrt(
            (x[a] * x[c]) /
              ((x[a] + x[b]) *
                 (x[c] + x[b]))
          )
        }
        
        # Cross-overlap:
        # (a,b) and (c,a)
        else if (b == c)
        {
          rho <- -sqrt(
            (x[a] * x[d]) /
              ((x[a] + x[b]) *
                 (x[c] + x[d]))
          )
        }
        
        # Cross-overlap:
        # (a,b) and (b,d)
        else if (a == d)
        {
          rho <- sqrt(
            (x[b] * x[c]) /
              ((x[a] + x[b]) *
                 (x[c] + x[d]))
          )
        }
        
        S[i, j] <- rho
        S[j, i] <- rho
      }
    }
    
    # ------------------------------------------------------------
    # Probability of all test statistics lying between -q and q
    # ------------------------------------------------------------
    
    lw1 <- rep(-q, Ncomp)
    up1 <- rep(q, Ncomp)
    
    # Power = 1 - P(-q < Z_i < q for all i)
    return(
      -(1 - pmvnorm(
        mean = m,
        sigma = S,
        lower = lw1,
        upper = up1
      ))
    )
  }


psi1<- function(theta,design,del,n,sigma,q){   # define the power based on the form of the LFCs
  
  
  mu[1]<- 0
  mu[2]<- theta[1]
  mu[3]<- theta[2]
  mu[4]<- theta[2]
  mu[5]<- theta[2]
  mu[6]<- theta[2]
  mu[7]<- theta[2]
  mu[8]<- theta[2]
  mu[9]<- theta[2]
  mu[10]<- theta[2]
  mu[11]<- del
  mu[12]<- theta[3]
  mu[13]<- theta[3]
  mu[14]<- theta[3]
  mu[15]<- theta[3]
  
  return(-psi(design,mu,del,n,sigma,q))
  
}
# Function for calculating the average power B

B<- function(design,theta_vals,prob_vals,del,n,sigma,q){
  
  s <- 0
  for (i in 1:length(prob_vals)){
    s <- s + prob_vals[i]* psi(design,theta_vals[i,],del,n,sigma,q)      # Average power associated to LFCs and probabilities
  }
  ret_val<-s
  return(ret_val[1])
}

# Function for compute optimum on the avarage design

get_optimal_on_the_average_design<- function(theta_vals,prob_vals,del,n,sigma,q)
{
  des_0 <-c(0.15,0.1,0.04,0.07)
  #options = optimoptions('fmincon','Display','none')
  const1 <- function(design,theta_vals,prob_vals,del,n,sigma,q) {
    return( (design[1]+design[2]+8*design[3]+5*design[4]-1))
  }
  
  const2 <- function(design,theta_vals,prob_vals,del,n,sigma,q) {
    return( c(design[2]-design[1],design[3]-design[2],design[4]-design[2],design[3]-design[4]))
  }
  
  
  lb <- c(0,0,0,0)
  ub <- c(0.17,0.13,0.045,0.075)
  local_opts <- list( "algorithm" = "NLOPT_LD_MMA", "xtol_rel" = 1.0e-7 )
  opts <- list( "algorithm"= "NLOPT_GN_ISRES",
                "xtol_rel"= 1.0e-7,
                "maxeval"= 20000,
                "local_opts" = local_opts,
                "print_level" = 0 )
  
  
  
  res <- nloptr ( x0 = des_0,
                  theta_vals = theta_vals,
                  prob_vals = prob_vals,
                  del=del,
                  n=n,
                  sigma=sigma,
                  q=q,
                  eval_f = B,
                  lb = lb,
                  ub = ub,
                  eval_g_eq = const1,
                  eval_g_ineq = const2,
                  opts = opts
  )
  
  return(res$solution)
  
}

