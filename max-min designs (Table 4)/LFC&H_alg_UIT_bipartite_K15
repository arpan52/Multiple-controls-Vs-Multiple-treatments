                "xtol_rel"= 1.0e-7,
                "maxeval"= 20000,
                "local_opts" = local_opts,
                "print_level" = 0 )
  # Computing the LFC
  
  res1 <- nloptr (x0 = theta_0,
                  design = design_l,
                  del=del,
                  n=n,
                  sigma=sigma,
                  q=q,
                  eval_f = psi1,
                  lb = lb,
                  ub = ub,
