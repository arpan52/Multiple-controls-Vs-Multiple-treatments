  theta_vals_l[10,1]<-  theta_vals_l[9,2]
  theta_vals_l[10,2]<-  theta_vals_l[9,1]
  theta_vals_l[10,3:10]<-  theta_vals_l[9,15]
  theta_vals_l[10,12:15]<-  theta_vals_l[9,3]

  
